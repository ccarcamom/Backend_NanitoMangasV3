# Copia este archivo a `.env` (o genera uno con deploy/gen-env.sh). NO subas `.env` a git.
# Usa valores largos y aleatorios; MONGO_ROOT_PASSWORD debe llevar solo letras y números (va dentro de una URL).
JWT_SECRET=cambia-esto-por-un-valor-aleatorio-de-64-caracteres
INTERNAL_KEY=cambia-esto-por-otro-valor-aleatorio
MONGO_ROOT_USER=nanito
MONGO_ROOT_PASSWORD=cambiaestaclave123
# Opcional: opciones de la JVM de cada servicio (memoria máxima por servicio).
# JAVA_OPTS=-Xmx256m -XX:+UseSerialGC
